---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { countStars, formatDate, stripLeadingEmoji } from '../../lib/text';
import { author, authorRef, toIsoDate } from '../../lib/seo';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({ params: { slug: book.id }, props: { book } }));
}

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const { Content } = await render(book);

const { title, summary, image, finished } = book.data;
const bookAuthors = book.data.author.split(',').map((name) => name.trim()).filter(Boolean);
const stars = countStars(book.data.score);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

const jsonLd = [
  {
    '@type': 'Review',
    '@id': `${pageUrl}#review`,
    url: pageUrl,
    name: `${title} by ${book.data.author}: book notes`,
    description: summary,
    datePublished: toIsoDate(finished),
    author: authorRef,
    publisher: authorRef,
    itemReviewed: {
      '@type': 'Book',
      name: title,
      author: bookAuthors.map((name) => ({ '@type': 'Person', name })),
      image: imageUrl,
    },
    ...(stars > 0 && {
      reviewRating: { '@type': 'Rating', ratingValue: stars, bestRating: 5, worstRating: 1 },
    }),
  },
  author,
];
---

<ArticleLayout
  title={title}
  documentTitle={`${title} by ${book.data.author} – Book Notes & Summary`}
  description={summary}
  image={image}
  imageAspect="tall"
  jsonLd={jsonLd}
>
  <div class="book-header">
    <div class="book-header-cover-wrap book-object">
      <img
        class="book-header-cover"
        src={book.data.image}
        alt={book.data.title}
        loading="lazy"
        decoding="async"
        onerror="this.style.visibility='hidden'"
      />
    </div>
    <div class="book-header-info">
      <span class="post-date">Finished {formatDate(book.data.finished)}</span>
      <h1 class="article-title">{book.data.title}</h1>
      <p class="book-header-author">{book.data.author}</p>
      <div class="book-header-meta">
        <p class="book-header-score">{book.data.score}</p>
        {
          book.data.badges.length > 0 && (
            <ul class="tag-list">
              {book.data.badges.map((badge) => (
                <li>{stripLeadingEmoji(badge)}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
  <div class="rule book-rule"></div>
  <Content />
</ArticleLayout>

<style>
  .book-header {
    display: flex;
    gap: clamp(20px, 4vw, 32px);
    align-items: flex-start;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .book-header-cover-wrap {
    flex: none;
  }

  .book-header-cover {
    display: block;
    width: 200px;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    flex: none;
  }

  .book-rule {
    margin-top: clamp(28px, 5vw, 40px);
  }

  .book-header-info {
    flex: 1 1 260px;
    min-width: 0;
  }

  .book-header-author {
    margin: 0 0 6px;
    color: var(--ink-70);
  }

  .book-header-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 14px;
  }

  .book-header-score {
    margin: 0;
  }

  .book-header-meta .tag-list {
    margin: 0;
  }
</style>
